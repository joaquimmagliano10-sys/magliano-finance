# ─────────────────────────────────────────────────────────────
# Provador virtual — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre na Vercel (produção).
# NADA aqui com prefixo diferente de NEXT_PUBLIC_ vai para o navegador.
# ─────────────────────────────────────────────────────────────

# Segredo para assinar sessões e tokens (mín. 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# ── Try-on em foto (IA) ──────────────────────────────────────
# auto (padrão: FASHN → fal), fashn, fal, replicate ou demo (sem IA, prévia simulada)
TRYON_PROVIDER=auto
# FASHN AI — https://app.fashn.ai (API Keys)
FASHN_API_KEY=
FASHN_MODEL=tryon-v1.6
# performance | balanced | quality
FASHN_MODE=balanced
# fal.ai (Kling Kolors Virtual Try-On) — https://fal.ai/dashboard/keys
FAL_KEY=
# Replicate (IDM-VTON — licença NÃO comercial, só para testes)
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=

# ── Controle de custo ────────────────────────────────────────
# provas por IP: "quantidade/segundos"
TRYON_RATE_LIMIT=5/600
# teto diário global de provas com IA (todas as pessoas somadas)
TRYON_DAILY_CAP=300
MAX_UPLOAD_MB=8

# ── Modo loja (/loja) ────────────────────────────────────────
# Abra uma vez no tablet: https://seu-site/loja?chave=<KIOSK_TOKEN>
KIOSK_TOKEN=
KIOSK_RATE_LIMIT=120/3600
# tempo (min) que a imagem do QR code fica disponível (máx. 1440 = 24 h)
RESULT_TTL_MINUTES=30

# ── Painel /admin ────────────────────────────────────────────
ADMIN_EMAIL=admin@loja.com
# gere com: npm run hash-senha -- "sua senha forte"   (no .env, escape os $ com \$)
ADMIN_PASSWORD_HASH=
# alternativa SÓ para desenvolvimento (em dev o padrão é admin123):
# ADMIN_PASSWORD=

# ── Infraestrutura (opcional localmente; recomendado na Vercel) ──
# Postgres (Neon / Vercel Postgres). Sem isso: arquivo local .data/db.json
DATABASE_URL=
# Vercel Blob (fotos do catálogo e resultados temporários). Sem isso: pasta .data/
BLOB_READ_WRITE_TOKEN=
# Upstash Redis (rate limit entre instâncias). Sem isso: memória do servidor
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Protege /api/cron/limpeza (a Vercel envia automaticamente)
CRON_SECRET=

# ── Marca (vão para o navegador) ─────────────────────────────
NEXT_PUBLIC_STORE_NAME=VESTE
NEXT_PUBLIC_STORE_SLOGAN=Prove antes de comprar.
NEXT_PUBLIC_STORE_CITY=São Paulo – SP
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_RAZAO_SOCIAL=
NEXT_PUBLIC_CNPJ=
NEXT_PUBLIC_EMAIL_PRIVACIDADE=
NEXT_PUBLIC_ENCARREGADO_LGPD=
